---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageHeader from "../../components/PageHeader.astro";

const allArticles = await getCollection("articles", ({ data }) => {
  return data.draft !== true;
});

const sortedArticles = allArticles.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("nb-NO", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
};
---

<Layout title="Alle artikler - Comino Web">
  <main
    class="bg-page-light dark:bg-page-dark min-h-screen pt-24 mt-20 pb-20 transition-colors duration-500"
  >
    <section class="container mx-auto px-6">
      <PageHeader
        title="Alle"
        accentWord="artikler"
        description="Komplett oversikt over våre artikler og innsikt."
      />

      <div class="max-w-4xl mx-auto space-y-6">
        {
          sortedArticles.length === 0 && (
            <p class="text-slate-500 text-center py-20 italic">
              Ingen artikler publisert ennå. Kommer snart!
            </p>
          )
        }

        {
          sortedArticles.map((article) => (
            <a
              href={`/artikler/${article.slug}`}
              class="group block bg-white dark:bg-slate-900/50 rounded-2xl border border-slate-200 dark:border-slate-800/60 overflow-hidden hover:shadow-lg dark:hover:shadow-primary/5 transition-all duration-300"
            >
              <div class="flex flex-col md:flex-row gap-6 p-6">
                {/* Bildet - venstre side */}
                <div class="md:w-72 shrink-0">
                  <div class="overflow-hidden rounded-xl aspect-video bg-slate-100 dark:bg-slate-800 h-40 md:h-full">
                    {article.data.image ? (
                      <Image
                        src={article.data.image}
                        alt={article.data.title}
                        transition:name={`img-list-${article.slug}`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    ) : (
                      <div class="w-full h-full bg-linear-to-br from-primary/10 to-blue-500/10 flex items-center justify-center">
                        <svg
                          class="w-8 h-8 text-primary/30"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-width="1.5"
                            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l4 4v10a2 2 0 01-2 2z"
                          />
                          <path stroke-width="1.5" d="M14 4v4h4" />
                        </svg>
                      </div>
                    )}
                  </div>
                </div>

                {/* Informasjon - høgre side */}
                <div class="flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center gap-3 mb-3 text-sm text-slate-500 dark:text-slate-400 font-medium">
                      <time datetime={article.data.publishDate.toISOString()}>
                        {formatDate(article.data.publishDate)}
                      </time>
                      <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-700" />
                      <span class="text-primary dark:text-primary-light uppercase tracking-wider text-[10px] font-bold">
                        {article.data.tags[0]}
                      </span>
                    </div>

                    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-primary dark:group-hover:text-primary-light transition-colors italic">
                      {article.data.title}
                    </h2>

                    <p class="text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2">
                      {article.data.description}
                    </p>
                  </div>

                  <div class="inline-flex items-center text-primary dark:text-primary-light font-bold mt-4 group-hover:gap-2 transition-all w-fit">
                    Les artikkelen
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-4 h-4 ml-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
    <div class="flex justify-center mt-16 pt-12 border-t border-slate-200 dark:border-slate-800/60">
        <a
          href="/artikler"
          class="inline-flex items-center gap-2 font-bold text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary-light transition-colors py-4 group"
        >
          Tilbake til artikkelsiden
          <svg
            class="w-5 h-5 group-hover:translate-x-2 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
  </main>
</Layout>